# ---------------------------------------------------------------------------
# JobAI environment
# Copy this file to `.env.local` (or `.env`) before running the app.
# ---------------------------------------------------------------------------

# Where the SQLite database file lives, relative to the project root.
DATABASE_FILE="data/jobai.db"

# Secret used to sign session tokens; at least 32 characters.
# If you leave this unset, the app generates a random secret on first run and
# saves it to data/.auth-secret. That is fine locally. For a real deployment,
# or anywhere running more than one instance, set it here instead:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# AUTH_SECRET=""

# How long a session stays valid.
SESSION_TTL_DAYS="7"

# Seed account credentials (used by `npm run db:seed` only).
SEED_ADMIN_EMAIL="admin@jobai.dev"
SEED_ADMIN_PASSWORD="Admin12345"
SEED_USER_EMAIL="demo@jobai.dev"
SEED_USER_PASSWORD="Demo12345"
